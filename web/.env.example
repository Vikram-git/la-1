# Supabase project (Settings > API). The publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (Settings > API Keys > Secret keys). Needed to create staff logins
# and reset passwords. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SECRET_KEY=

# Optional: WhatsApp Business (Cloud API) sends quotations from the server. Leave the token empty to keep
# sending from staff devices only. From Meta: WhatsApp > API Setup (phone number ID) and a permanent
# System User token with whatsapp_business_messaging. Server-only: never prefix with NEXT_PUBLIC_.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved message templates: DOCUMENT header for the PDF, IMAGE header for the PNG (leave empty to send
# PDFs only), one body variable {{1}} = the order number. Language code as approved in Meta.
WHATSAPP_QUOTATION_TEMPLATE_PDF=quotation_pdf
WHATSAPP_QUOTATION_TEMPLATE_PNG=
WHATSAPP_TEMPLATE_LANGUAGE=en
# true: a confirmed order's quotation PDF goes to the customer automatically.
WHATSAPP_AUTO_SEND_ON_CONFIRM=false
